# systemd unit for the host that talks to the LED board (typically a Pi on the same LAN).
#
# Replaces the original's run.sh, which slept 60 seconds, cd'd to a hardcoded home
# directory, set the mixer to 100%, and backgrounded the script with no supervision --
# if it crashed, the board simply stopped updating until someone noticed.
#
# Install (see deploy/install.sh, which does all of this):
#   sudo cp deploy/nhl-ticker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nhl-ticker
# Logs:
#   journalctl -u nhl-ticker -f

[Unit]
Description=NHL Score Ticker
Documentation=https://github.com/ncnuech/NHL-Score-Scraper
# The board lives on the LAN, so do not start before the network is actually up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nhl
WorkingDirectory=/opt/nhl-score-ticker/engine

# Optional: the leading '-' means a missing .env is not a startup failure. .env is
# gitignored, so a fresh clone has none and an unprefixed EnvironmentFile would make the
# unit refuse to start.
EnvironmentFile=-/opt/nhl-score-ticker/engine/.env

# Run the virtualenv's interpreter directly rather than going through `uv run`. uv wants a
# writable cache (~/.cache/uv by default), which ProtectHome=true below makes unreachable,
# so `uv run` here fails at startup. Create the venv once at install time instead; see
# deploy/install.sh. This is also the usual shape for a service: no resolver on the hot
# path, no network needed to start.
ExecStart=/opt/nhl-score-ticker/engine/.venv/bin/python -m nhl_ticker

# The NHL API goes quiet overnight and the Yun drops connections; neither is fatal, so
# always come back rather than giving up after a burst of restarts.
Restart=always
RestartSec=10s
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nhl-ticker

# It only needs to reach the NHL API, the board, and the sound device.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nhl-score-ticker

# Goal horns need the audio device, which PrivateDevices would hide. Drop this line (and
# set TICKER_HORN_ENABLED=false) if you are running board-only.
DeviceAllow=char-alsa rw
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target
