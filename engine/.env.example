# Copy to .env and adjust. No secrets belong in this file or in the repo.

# Arduino Yun LED board. Disabled by default so the engine runs headless/emulator-only.
TICKER_BOARD_ENABLED=false
TICKER_BOARD_HOST=10.177.105.137
# Calibrate against real hardware during bring-up.
TICKER_BOARD_FRAME_MS=33

# Goal horn audio.
TICKER_HORN_ENABLED=false

# Poll cadence (seconds).
TICKER_POLL_LIVE_SECONDS=8
TICKER_POLL_PREGAME_SECONDS=300
TICKER_POLL_IDLE_SECONDS=1800

# Local web server for the React test UI.
TICKER_HOST=127.0.0.1
TICKER_PORT=8000
