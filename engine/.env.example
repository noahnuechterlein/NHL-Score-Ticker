# Copy to .env and adjust. No secrets belong in this file or in the repo.

# --- Arduino Yun LED board ---
# Disabled by default so the engine runs emulator-only with no hardware attached.
TICKER_BOARD_ENABLED=false
TICKER_BOARD_HOST=10.177.105.137
# Milliseconds per scroll frame. Derived from the sketch (~924 px x 24 bits + delay(1));
# measure a long message on real hardware during bring-up and correct this.
TICKER_BOARD_FRAME_MS=33
# How long a non-scrolling message keeps the board. The sketch frees itself after its own
# delay(2000), so anything below 2s risks a short alert being overwritten immediately.
TICKER_BOARD_MIN_DWELL_SECONDS=5
TICKER_BOARD_STATIC_HOLD_SECONDS=2
# Brightness byte folded into every colour as (channel * br) >> 8.
TICKER_BOARD_BRIGHTNESS=30

# --- Goal horns (requires the `horn` extra: uv run --extra horn) ---
TICKER_HORN_ENABLED=false
TICKER_HORN_MAX_SECONDS=10

# --- Poll cadence (seconds), chosen by game state rather than wall-clock time ---
TICKER_POLL_LIVE_SECONDS=8
TICKER_POLL_PREGAME_SECONDS=300
TICKER_POLL_IDLE_SECONDS=1800

# --- Local web server for the React test UI ---
TICKER_HOST=127.0.0.1
TICKER_PORT=8000
